# ─── Frontend Environment Variables Template ─────────────────────────────────
# Copy this file to .env.local and fill in the values before running the app.
# cp .env.local.template .env.local

# ─── Backend URL ─────────────────────────────────────────────────────────────
# URL used server-side (Route Handlers, SSR) to reach the backend API.
# In Docker/container environments, use the internal service name (e.g. http://backend:80).
# In local development, use the host machine address.
BACKEND_URL=http://localhost:4880

# URL exposed to the browser (client components).
# Must be publicly accessible from the end-user's browser.
# In local development this is the same as BACKEND_URL.
NEXT_PUBLIC_BACKEND_URL=http://localhost:4880

# ─── AWS (used for trust-policy helper in role-permissions.ts) ───────────────
# ARN of the platform IAM user — used to build AWS trust-policy templates shown in the UI.
# Format: arn:aws:iam::<ACCOUNT_ID>:user/<USERNAME>
AWS_USER_ARN=arn:aws:iam::371117669756:user/saas-multicloud
