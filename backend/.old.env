# ─── GCP (cloud assessment) ──────────────────────────────────────────────────
# Service account JSON of the PLATFORM's own GCP SA used for impersonation.
# The SA must have the "Service Account Token Creator" role on each customer SA.
#
# Option 1 — base64-encoded (recommended for env files):
#   base64 -i platform-sa-key.json | tr -d '\n'
# Option 2 — raw JSON string (single line, with escaped quotes):
#   {"type":"service_account","project_id":"...","private_key_id":"..."}
#
# How to obtain:
#   1. In the GCP Console, go to IAM & Admin → Service Accounts.
#   2. Create (or select) the platform SA and go to Keys → Add Key → JSON.
#   3. Download the key file and encode it: base64 -i key.json | tr -d '\n'
GCP_SA_CREDENTIALS_
#[Convert]::ToBase64String([IO.File]::ReadAllBytes("C:\caminho\para\sua-chave.json"))

# GCP workers concurrency (BullMQ)
# Default: 2 | Recommended range: 1-4 (hard cap: 16)
GCP_GENERAL_SYNC_WORKER_CONCURRENCY=2

# ─── Stripe (billing) ────────────────────────────────────────────────────────
# Secret API key — use sk_test_... for development, sk_live_... for production
STRIPE_SECRET_KEY=sk_test_51TAUjTGwDMbxqyo7bzGRXtnglJqrbVnV0N5ltfZRN9YOQAwwnRpDS8334usTmdFQYqF46CjE9tXYsUpl75jfowCQ00NA07HgCg

# Webhook signing secret — obtained from the Stripe dashboard or CLI (whsec_...)
# Used to verify that webhook events are genuinely from Stripe
STRIPE_WEBHOOK_SECRET=whsec_tLS3DFGSCZrJTk8mVnDG9SFaBztsWx2e

# Default Stripe Product ID assigned to every new organization on creation.
# The price used will be the product's default_price (if set and recurring),
# otherwise the first active recurring price found for that product.
# The product must have the following metadata:
#   max_cloud_accounts  — e.g. "5"
#   max_users           — e.g. "10"
#   modules             — comma-separated, e.g. "resources" or "assessment,resources"
DEFAULT_STRIPE_PRODUCT_ID=prod_U8mghD0KHf7ntJ

# ─── File Storage ───────────────────────────────────────────────────────────
# File storage strategy:
#   1. If FILE_BUCKET_NAME is NOT set → files are stored in application memory
#   2. If FILE_BUCKET_NAME is set → files are stored in S3 or MinIO
#
# For memory storage (current - leave empty):
FILE_BUCKET_NAME=
FILE_STORAGE_PROVIDER=s3

# For S3 storage (uncomment when needed):
# FILE_BUCKET_NAME=my-bucket
# FILE_STORAGE_PROVIDER=s3
# AWS_REGION=us-east-1

# For MinIO storage (uncomment when needed):
# FILE_BUCKET_NAME=my-bucket
# FILE_STORAGE_PROVIDER=minio
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_REGION=us-east-1


# # Backend
# GOOGLE_ALLOWED_REDIRECT_ORIGINS=https://app.seudominio.com,https://www.seudominio.com
FRONTEND_URL=http://localhost:3000
# GOOGLE_CALLBACK_URL=https://api.seudominio.com/api/auth/google/callback
# Isola filas BullMQ do worker remoto que compartilha este Redis
BULLMQ_PREFIX=local-dev


# ─── AI Chat ─────────────────────────────────────────────────────────────────
# Provider abstraction. Currently supported: openai
AI_CHAT_PROVIDER=openai
# OpenAI API key — never expose to the frontend
OPENAI_API_KEY=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
# Model used for chat completions with tool calling
OPENAI_MODEL=gpt-6-luna
# Optional OpenAI-compatible base URL (Azure OpenAI / proxies). Leave empty for OpenAI.
# OPENAI_BASE_URL=
# Request timeout in milliseconds
AI_CHAT_TIMEOUT_MS=60000
# Max completion tokens per turn
AI_CHAT_MAX_TOKENS=2048
# Max tool calls allowed per user message
AI_CHAT_MAX_TOOL_CALLS=6
# Max prior messages sent as context
AI_CHAT_MAX_HISTORY_MESSAGES=20
# Per-user throttle for AI chat routes (requests per minute)
AI_CHAT_RATE_LIMIT_PER_MINUTE=20

